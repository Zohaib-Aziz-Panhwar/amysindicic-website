# amysindicic.com -- document root
#
# Two sites share this directory:
#   /            the React site (this repo's dist/)
#   /old-site/   the previous WordPress site, kept for reference
#
# The React site has no server: every route below is the same index.html,
# and the browser-side router decides what to render. So Apache has to serve
# index.html for any path that is not a real file -- except inside /old-site/,
# which has its own rules.

Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Canonical host, matching what the old site already did.
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # Hand the archive straight to its own .htaccess. This must stay above the
  # single-page-app fallback or WordPress would never see a request.
  RewriteRule ^old-site(/|$) - [L]

  # The archived site's content keeps its original absolute URLs
  # (/wp-content/..., /wp-includes/...). Send those into the archive so its
  # pages keep their images without rewriting anything in the database.
  RewriteRule ^(wp-content|wp-includes|wp-admin)/(.*)$ /old-site/$1/$2 [L]
  RewriteRule ^(wp-login\.php|xmlrpc\.php)$ /old-site/$1 [L]

  # Articles that moved under /blog/ in the rebuild. Old links and anything
  # Google still has indexed keep working.
  RewriteRule ^the-visibility-gap-why-qualified-leaders-get-overlooked/?$ /blog/the-visibility-gap-why-qualified-leaders-get-overlooked [R=301,L]
  RewriteRule ^its-who-you-know-not-what-you-know-but-thats-not-why-most-professionals-get-stuck/?$ /blog/its-who-you-know-not-what-you-know-but-thats-not-why-most-professionals-get-stuck [R=301,L]
  RewriteRule ^gs-14-gs-15-proven-leaders-so-why-were-they-being-overlooked/?$ /blog/gs-14-gs-15-proven-leaders-so-why-were-they-being-overlooked [R=301,L]
  RewriteRule ^he-completed-skillbridge-so-why-was-he-still-struggling/?$ /blog/he-completed-skillbridge-so-why-was-he-still-struggling [R=301,L]
  RewriteRule ^the-road-to-ses-isnt-always-straight/?$ /blog/the-road-to-ses-isnt-always-straight [R=301,L]
  RewriteRule ^identity-before-in/?$ /blog/identity-before-in [R=301,L]

  # Anything that is not a real file or directory is the app's to route.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ /index.html [L]
</IfModule>

# Asset filenames carry a content hash, so they can be cached hard. index.html
# must not be, or a visitor keeps loading the previous build's asset names.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?|jpg|jpeg|png|webp|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>
